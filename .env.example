# ECO-ARB configuration. Every value here has a working default — copy this to
# .env only if you want to override something. Nothing here is a secret: the UK
# Carbon Intensity API needs no key.

# --- Grid feed -------------------------------------------------------------
# Upstream API base. Point this at a mock to demo without network.
CARBON_API_BASE=https://api.carbonintensity.org.uk
# How often (REAL seconds) to re-pull the 24h forecast.
GRID_REFRESH_SECONDS=300

# --- Scheduler -------------------------------------------------------------
# How often (REAL seconds) the scheduler checks for due jobs.
TICK_SECONDS=1.0
# Minimum carbon saving (%) worth deferring for. Below this, jobs run now.
MIN_SAVING_PCT=1.0

# --- Executor --------------------------------------------------------------
# Scales how much real CPU a job burns. 1.0 puts a 10 kWh job at roughly six
# seconds on a modern laptop. Lower it on a slow machine, raise it if jobs
# finish before the audience notices they started.
ECO_ARB_WORK_SCALE=1.0
# Where execution artifacts are written. Defaults to backend/artifacts/.
# ECO_ARB_ARTIFACTS=/var/tmp/eco-arb

# The 'shell' workload runs this command and nothing else. It is unset by
# default on purpose: without it the workload refuses to run, so an exposed
# instance cannot be turned into a command runner by posting a job.
# ECO_ARB_SHELL_CMD=python3 -c "print('real deferred work')"

# --- Frontend --------------------------------------------------------------
# Leave empty to use the Vite dev proxy (/api -> 127.0.0.1:8000). Set it only
# when serving the built frontend against a backend on another origin.
# VITE_API_BASE=http://127.0.0.1:8000

# --- Regions and data provenance -------------------------------------------
# operational (default) serves real provider data: the UK national feed, and
# NESO regional forecasts for London and North Scotland. scenario serves a
# HARDCODED SYNTHETIC fixture for every region, including the Indian grids, so
# the guided demo has predictable RUN / WAIT / SHIFT cases. Synthetic rows are
# always flagged live=false with source_kind=synthetic_scenario, and the UI
# labels them -- but do not describe them as measured data.
# ECO_ARB_DEMO_MODE=scenario

# Real Indian forecasts. There is no free public Indian carbon intensity feed,
# so in-north and in-south stay "Not connected" until one of these is true:
#   1. this token is set, and the app pulls Electricity Maps directly, or
#   2. you POST real half-hourly rows to /api/regions/import (Regions tab ->
#      "Import an Indian forecast"), which are labelled operator-supplied.
# Without either, the Indian regions carry no data outside scenario mode.
# ELECTRICITY_MAPS_TOKEN=your-token-here
#
# EnergyMap India / Atlas. Unlocks the live Indian national fuel mix and, more
# usefully, real IEX real-time-market clearing prices -- the one place in this
# system where a measured price replaces a modelled one. Without it the Indian
# national region falls back to the recorded 2026-09-19 provider capture, which
# is real data on a replayed clock and is labelled as such.
#
# Never commit a filled-in .env. If a key has been shared in a zip, a chat or a
# screenshot, treat it as public and rotate it.
# ATLAS_API_KEY=your-key-here
#
# ---------------------------------------------------------------------------
# Where these keys go, and where they must not
#
# .env is gitignored and has never been committed; only this example file is
# tracked. Verified over the whole history, not assumed. Keep it that way:
#
#   Local development   .env in the repository root. Never staged.
#   CI                  Nothing. The test suite runs entirely offline, on the
#                       fallback curve and the committed capture, so CI needs
#                       no key and none is configured for it. If that ever
#                       changes, use Actions secrets -- never a file.
#   Deployed site       Nothing. The hosted build is static and holds no key;
#                       a key in a frontend bundle is public the moment it
#                       ships, whatever the hosting.
#
# Rotating, if a key is exposed:
#   Electricity Maps    portal.electricitymaps.com -> API keys -> revoke, issue
#   EnergyMap / Atlas   energymap.in account -> API keys -> revoke, issue
# Revoke the old one first. Issuing a replacement does not disable the old key,
# so a leaked key stays live until it is explicitly revoked.
